{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitspay.local/schemas/disbursement-service/disbursement.events/SCHEDULED_TRANSFER_EXECUTED.v1.schema.json",
  "title": "disbursement.events SCHEDULED_TRANSFER_EXECUTED v1 — envelope.data",
  "description": "Scheduled occurrence reached a final outcome (COMPLETED / FAILED / SKIPPED). aggregateType ScheduledTransfer; Kafka key = envelope aggregateId = data.scheduleId. Producer disbursement-service.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "scheduleId",
    "occurrenceDate",
    "payerWalletId",
    "payeeWalletId",
    "amountPoisha",
    "outcome",
    "txnRef",
    "failureCode"
  ],
  "properties": {
    "scheduleId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "occurrenceDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Asia/Dhaka"
    },
    "payerWalletId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "payeeWalletId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "amountPoisha": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000000000,
      "description": "int64 poisha"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "FAILED",
        "SKIPPED"
      ]
    },
    "txnRef": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9-]{1,32}$",
      "description": "P2P txnRef, opaque; null for SKIPPED or when no payment was created"
    },
    "failureCode": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "non-null iff outcome = FAILED: problem code returned by the P2P call, or DEPENDENCY_UNAVAILABLE"
    }
  }
}