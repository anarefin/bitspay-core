{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitspay.local/schemas/disbursement-service/disbursement.events/PAYMENT_REQUEST_ACCEPTED.v1.schema.json",
  "title": "disbursement.events PAYMENT_REQUEST_ACCEPTED v1 — envelope.data",
  "description": "Payment request paid (-> PAID). aggregateType PaymentRequest; Kafka key = envelope aggregateId = data.requestId. Producer disbursement-service.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "requestId",
    "requestRef",
    "requesterWalletId",
    "payerWalletId",
    "amountPoisha",
    "txnRef"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "requestRef": {
      "type": "string",
      "pattern": "^RQ\\d{6}[0-9A-HJKMNP-TV-Z]{8}$"
    },
    "requesterWalletId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "payee"
    },
    "payerWalletId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "amountPoisha": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000000000,
      "description": "int64 poisha"
    },
    "txnRef": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{1,32}$",
      "description": "P2P txnRef, opaque"
    }
  }
}