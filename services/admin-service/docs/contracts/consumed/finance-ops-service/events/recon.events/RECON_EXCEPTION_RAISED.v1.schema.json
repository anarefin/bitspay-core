{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitspay.local/schemas/finance-ops-service/recon.events/RECON_EXCEPTION_RAISED.v1.schema.json",
  "title": "recon.events RECON_EXCEPTION_RAISED v1 — envelope.data (aggregateType ReconRun, key runId)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "runId",
    "exceptionId",
    "category",
    "source",
    "severity",
    "businessDate",
    "commandId",
    "txnRef",
    "amountPoisha"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "exceptionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "MISSING_IN_LEDGER",
        "MISSING_IN_TXN",
        "MISSING_IN_SOURCE",
        "MISSING_AT_COUNTERPARTY",
        "AMOUNT_MISMATCH",
        "ACCOUNT_MISMATCH",
        "STATUS_MISMATCH",
        "DUPLICATE",
        "NEGATIVE_BALANCE",
        "TRIAL_BALANCE_BREAK",
        "EMONEY_VARIANCE",
        "PROJECTION_DRIFT",
        "LATE_LEDGER_EVENT",
        "STATEMENT_BALANCE_BREAK",
        "GL_UNMAPPED",
        "GL_TIEOUT_BREAK"
      ],
      "description": "GL_UNMAPPED is reserved and never emitted"
    },
    "source": {
      "type": "string",
      "enum": [
        "LEDGER_TXN",
        "FILE",
        "EMONEY",
        "EOD",
        "PROJECTION",
        "GL"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH"
      ]
    },
    "businessDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "commandId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "txnRef": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9-]{1,32}$"
    },
    "amountPoisha": {
      "type": [
        "integer",
        "null"
      ],
      "description": "signed: FILE = statement sign (+ = credit at bank); ledger categories = expected − actual"
    }
  }
}