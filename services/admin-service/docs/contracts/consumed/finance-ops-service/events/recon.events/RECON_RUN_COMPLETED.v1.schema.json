{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitspay.local/schemas/finance-ops-service/recon.events/RECON_RUN_COMPLETED.v1.schema.json",
  "title": "recon.events RECON_RUN_COMPLETED v1 — envelope.data (aggregateType ReconRun, key runId)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "runId",
    "type",
    "businessDate",
    "matched",
    "exceptions",
    "status",
    "revision"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "= envelope aggregateId = Kafka key"
    },
    "type": {
      "type": "string",
      "enum": [
        "LEDGER_TXN",
        "EOD",
        "TRIAL_BALANCE",
        "EMONEY",
        "FILE",
        "PROJECTION_VERIFY",
        "GL_TIEOUT"
      ]
    },
    "businessDate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "null only for FILE"
    },
    "matched": {
      "type": "integer",
      "minimum": 0
    },
    "exceptions": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "COMPLETED_WITH_EXCEPTIONS",
        "FAILED",
        "RESTATED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "all members optional",
      "properties": {
        "trialBalance": {
          "type": "string",
          "enum": [
            "OK",
            "BREAK"
          ]
        },
        "emoney": {
          "type": "string",
          "enum": [
            "MATCHED",
            "VARIANCE",
            "INCOMPLETE"
          ]
        },
        "glSummaryReady": {
          "type": "boolean",
          "description": "always false (GL summaries are owned by general-ledger-service); kept for compatibility"
        },
        "mode": {
          "type": "string",
          "enum": [
            "EOD",
            "LIVE"
          ]
        },
        "fromDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "toDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "counterpartyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "partial": {
          "type": "boolean"
        },
        "forced": {
          "type": "boolean"
        },
        "glTieOut": {
          "type": "string",
          "enum": [
            "MATCHED",
            "BREAK"
          ],
          "description": "present iff type = GL_TIEOUT"
        },
        "glRevision": {
          "type": "integer",
          "minimum": 1,
          "description": "present iff type = GL_TIEOUT"
        }
      }
    }
  }
}