{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitspay.local/schemas/pricing-service/commission.events/COMMISSION_SETTLED.v1.schema.json",
  "title": "CommissionSettled",
  "description": "Emitted when ledger command post-commission-settlement returns OK/EXISTS; key = beneficiaryWalletId. A cash movement of already-accrued commission, not additional earnings.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "settlementId",
    "beneficiaryWalletId",
    "period",
    "grossPoisha",
    "aitPoisha",
    "netPoisha",
    "ledgerCommandId",
    "txnRef",
    "accrualCount"
  ],
  "properties": {
    "settlementId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "= ledgerCommandId"
    },
    "beneficiaryWalletId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "= key"
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}/\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO-8601 interval of inclusive business dates"
    },
    "grossPoisha": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "aitPoisha": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "0 <= ait < gross"
    },
    "netPoisha": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "= gross - ait"
    },
    "ledgerCommandId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "post-commission-settlement commandId"
    },
    "txnRef": {
      "type": "string",
      "pattern": "^CMS-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{8}$",
      "description": "CMS-{yyyyMMdd(periodEnd)}-{8 Crockford}; consumers treat it as opaque 1..32"
    },
    "accrualCount": {
      "type": "integer",
      "minimum": 1
    }
  }
}
