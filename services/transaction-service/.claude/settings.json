{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)/scripts/scope_check.py\" claude-hook"
          }
        ]
      }
    ]
  }
}
