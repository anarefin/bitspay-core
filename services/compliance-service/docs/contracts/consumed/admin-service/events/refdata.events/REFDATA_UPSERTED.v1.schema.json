{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitspay.local/schemas/admin-service/refdata.events/REFDATA_UPSERTED.v1.schema.json",
  "title": "refdata.events REFDATA_UPSERTED data (compacted; key {type}:{code}; never tombstoned)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "code",
    "parentCode",
    "nameEn",
    "nameBn",
    "attributes",
    "version",
    "active"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "GEO",
        "MCC",
        "PURPOSE_CODE",
        "REASON_CODE",
        "BANK",
        "HOLIDAY",
        "SYSTEM_PARAM"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "parentCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "nameEn": {
      "type": "string",
      "maxLength": 200
    },
    "nameBn": {
      "type": "string",
      "maxLength": 200
    },
    "attributes": {
      "type": "object"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "active": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "GEO"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2})?)?)?$"
          },
          "attributes": {
            "$ref": "#/$defs/GEO"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "MCC"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "attributes": {
            "$ref": "#/$defs/MCC"
          },
          "parentCode": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PURPOSE_CODE"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z_]{3,32}$"
          },
          "attributes": {
            "$ref": "#/$defs/PURPOSE_CODE"
          },
          "parentCode": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "REASON_CODE"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z_]{3,40}$"
          },
          "attributes": {
            "$ref": "#/$defs/REASON_CODE"
          },
          "parentCode": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "BANK"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{3,12}$"
          },
          "attributes": {
            "$ref": "#/$defs/BANK"
          },
          "parentCode": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "HOLIDAY"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "attributes": {
            "$ref": "#/$defs/HOLIDAY"
          },
          "parentCode": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SYSTEM_PARAM"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)+$"
          },
          "attributes": {
            "$ref": "#/$defs/SYSTEM_PARAM"
          },
          "parentCode": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "GEO": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "level",
        "bbsCode"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "DIVISION",
            "DISTRICT",
            "UPAZILA",
            "UNION"
          ]
        },
        "bbsCode": {
          "type": "string"
        },
        "cityCorporation": {
          "type": "boolean"
        },
        "riskFlag": {
          "type": "boolean",
          "default": false
        },
        "qrCity": {
          "type": "string",
          "maxLength": 15,
          "pattern": "^[A-Z ]+$"
        }
      }
    },
    "MCC": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "group",
        "riskLevel"
      ],
      "properties": {
        "group": {
          "type": "string",
          "enum": [
            "01",
            "02",
            "03",
            "04",
            "05",
            "06",
            "07",
            "99"
          ]
        },
        "riskLevel": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      }
    },
    "PURPOSE_CODE": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "appliesTo",
        "requiresNote"
      ],
      "properties": {
        "appliesTo": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "requiresNote": {
          "type": "boolean"
        }
      }
    },
    "REASON_CODE": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "domain",
        "customerVisible"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "WALLET",
            "REVERSAL",
            "HOLD",
            "REFUND",
            "KYC",
            "PARTNER",
            "APPROVAL",
            "OTHER"
          ]
        },
        "customerVisible": {
          "type": "boolean"
        }
      }
    },
    "BANK": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "trustEligible"
      ],
      "properties": {
        "routingPrefix": {
          "type": "string"
        },
        "swift": {
          "type": "string"
        },
        "trustEligible": {
          "type": "boolean"
        }
      }
    },
    "HOLIDAY": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "date",
        "kind",
        "bankHoliday",
        "provisional"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "BANK",
            "OPTIONAL"
          ]
        },
        "bankHoliday": {
          "type": "boolean"
        },
        "provisional": {
          "type": "boolean"
        }
      }
    },
    "SYSTEM_PARAM": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "valueType"
      ],
      "properties": {
        "valueType": {
          "type": "string",
          "enum": [
            "STRING",
            "INT",
            "BOOL",
            "TIME",
            "DURATION",
            "CRON",
            "JSON",
            "FEATURE",
            "RETENTION"
          ]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "valueType": {
                "const": "FEATURE"
              }
            }
          },
          "then": {
            "required": [
              "enabled",
              "channels",
              "licenceRef"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "APP",
                    "USSD",
                    "PARTNER_APP",
                    "PORTAL",
                    "BACKOFFICE",
                    "API",
                    "SYSTEM"
                  ]
                },
                "uniqueItems": true
              },
              "licenceRef": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueType": {
                "const": "RETENTION"
              }
            }
          },
          "then": {
            "required": [
              "onlineMonths",
              "totalYears",
              "basis",
              "endAction",
              "legalHold"
            ],
            "properties": {
              "onlineMonths": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "totalYears": {
                "type": "integer",
                "minimum": 0
              },
              "basis": {
                "type": "string",
                "enum": [
                  "EVENT_DATE",
                  "RELATIONSHIP_END",
                  "CASE_CLOSURE"
                ]
              },
              "endAction": {
                "type": "string",
                "enum": [
                  "PURGE",
                  "ANONYMISE"
                ]
              },
              "legalHold": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueType": {
                "enum": [
                  "STRING",
                  "INT",
                  "BOOL",
                  "TIME",
                  "DURATION",
                  "CRON",
                  "JSON"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "valueType": {
                "const": "INT"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueType": {
                "const": "BOOL"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueType": {
                "const": "TIME"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueType": {
                "enum": [
                  "STRING",
                  "DURATION",
                  "CRON"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
