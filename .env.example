# Local-only values for the Compose stack. `make` copies this file to .env (git-ignored). Never reuse outside a laptop.
PG_ADMIN_PASSWORD=local-admin-only
PG_SERVICE_PASSWORD=local-dev-only
PG_DEBEZIUM_PASSWORD=local-debezium-only
BITSPAY_PLATFORM_HMAC_KEY=local-dev-only-hmac-key-change-me-0123456789
LEDGER_JOURNAL_MAC_KEY=local-dev-only-journal-mac-key
S3_ACCESS_KEY=bitspay
S3_SECRET_KEY=local-dev-only-s3-secret
RABBITMQ_USER=bitspay
RABBITMQ_PASSWORD=local-dev-only
CLICKHOUSE_RW_PASSWORD=local-dev-only
CLICKHOUSE_RO_PASSWORD=local-dev-only-ro

# Field cipher keys (AES-256-GCM, base64 of 32 bytes), one per service (kernel K8.3)
FIELD_CIPHER_KEY_LEDGER=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_TRANSACTION=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_WALLET=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_LIMITS_RISK=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_PRICING=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_TREASURY=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_DISBURSEMENT=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_SUPPORT=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_COMPLIANCE=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_FINANCE_OPS=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_ADMIN=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=
FIELD_CIPHER_KEY_GENERAL_LEDGER=bG9jYWwtZGV2LW9ubHkta2V5LTAxMjM0NTY3ODlhYmM=

