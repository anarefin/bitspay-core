  },
  {
    "prefix": "RQ",
    "kind": "non-ledger-reference",
    "meaning": "requestRef of a payment request (never sent to the ledger, never a txnRef)",
    "format": "RQ{yyMMdd}{8 Crockford base32}",
    "length": 16,
    "example": "RQ261009P3X8K2NM",
    "open": "D-13",
    "owner": "disbursement-service"
  },
  {
    "prefix": "BD…-",
    "kind": "derived-reference",
    "meaning": "rowRef = {batchRef}-{rowNo}: human-readable ID of one disbursement credit (not a txnRef; no per-row txnRef prefix exists)",
    "format": "{batchRef}-{rowNo}",
    "length": "<= 24",
    "example": "BD261009K7Q2M4ZD-42",
    "open": "D-13",
    "owner": "disbursement-service"
  },
  {
    "prefix": "T",
    "meaning": "support ticket number — a human-readable non-ledger business reference; never a txnRef, never sent to the ledger",
    "format": "T{yyMMdd}{6+ digit daily seq} (Asia/Dhaka calendar date), 13..14 chars, e.g. T261009000123",
    "owner": "support-service"
  },
  {
    "prefix": "RCA-",
    "meaning": "reconciliation ledger adjustment (command 11, module reconciliation)",
    "format": "RCA-{yyyyMMdd}-{8 Crockford base32} (21 chars)",
    "owner": "finance-ops-service"
  },
  {
    "prefix": "GLJ",
    "meaning": "GL journal reference (never a ledger txnRef; no ledger command uses it)",
    "format": "GLJ-{yyyyMMdd}-L-R{revision} for LEDGER_DAY; GLJ-{yyyyMMdd}-{M|A|X|R|I|Y|O}-{6-digit seq per day} otherwise",
    "owner": "general-ledger-service"
  }
